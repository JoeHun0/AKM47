# Keep the public source set explicit; everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.txt
!/CREDITS.txt
!/BUILDING.md
!/CHANGELOG.md
!/tools/
!/text/
!/zonekit/

/tools/*
!/tools/*.py
!/tools/icons/
/tools/icons/*
!/tools/icons/*.py
!/tools/icons/*.sh
!/tools/icons/cam_*.json

/text/*
!/text/AKM47_text.txt
!/text/AKM47_zh-Hans.json

/zonekit/*
!/zonekit/Content/
/zonekit/Content/*
!/zonekit/Content/GameLite/

__pycache__/
*.pyc
*.pak
*.ucas
*.utoc
*.zip
*.dll
*.exe
Key.txt
.env
.env.*
